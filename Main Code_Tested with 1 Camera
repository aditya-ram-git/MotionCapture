HDR_FILL  = PatternFill("solid", start_color="1F4E79")  # Dark blue fill for headers
HDR_FONT  = Font(bold=True, color="FFFFFF", name="Arial", size=9)  # White bold text
ALT_FILL  = PatternFill("solid", start_color="F2F2F2")
NORM_FONT = Font(name="Arial", size=9)
THIN      = Border(left=Side(style="thin"), right=Side(style="thin"), top=Side(style="thin"), bottom=Side(style="thin"))
CENTER    = Alignment(horizontal="center", vertical="center")

def _style_header(ws, row: int, n_cols: int):
    """Applies corporate dark-blue styling and borders to a header row."""
    for col in range(1, n_cols + 1):
        c = ws.cell(row=row, column=col)
        c.fill = HDR_FILL
        c.font = HDR_FONT
        c.border = THIN
        c.alignment = CENTER

def _autowidth(ws, min_w=10, max_w=32):
    """Auto-fits column widths based on maximum cell string length."""
    for col_cells in ws.columns:
        length = max((len(str(c.value)) if c.value is not None else 0) for c in col_cells)
        ws.column_dimensions[get_column_letter(col_cells[0].column)].width = max(min_w, min(length + 3, max_w))

def write_excel(
    path: str, 
    cam_coord_dfs: Dict[int, pd.DataFrame], 
    df_3d: pd.DataFrame, 
    metadata_df: pd.DataFrame,
    active_indices: List[int],
    max_excel_rows: int = 1000000
):
    """
    Writes all 2D coordinates, 3D world points, and video hardware metadata into an Excel file.
    Splits sheets across tabs if any dataset exceeds max_excel_rows.
    """
    formatted_sheets = []

    with pd.ExcelWriter(path, engine="openpyxl") as writer:
        # Tab 1: Video Hardware & Stream Metadata (Detector Results)
        if not metadata_df.empty:
            metadata_df.to_excel(writer, sheet_name="Video Metadata", index=False)
            formatted_sheets.append(("Video Metadata", len(metadata_df.columns)))

        # Tab 2+: 2D Camera Coordinate Data
        for cam_id in active_indices:
            df_cam = cam_coord_dfs[cam_id]
            total_rows = len(df_cam)
            
            if total_rows == 0:
                sheet_name = f"Cam {cam_id} ({CAMERA_NAMES[cam_id]})"
                df_cam.to_excel(writer, sheet_name=sheet_name, index=False)
                formatted_sheets.append((sheet_name, len(df_cam.columns)))
            else:
                num_chunks = math.ceil(total_rows / max_excel_rows)
                for chunk_idx in range(num_chunks):
                    start_idx = chunk_idx * max_excel_rows
                    end_idx = start_idx + max_excel_rows
                    df_chunk = df_cam.iloc[start_idx:end_idx]
                    
                    base_name = f"Cam {cam_id} ({CAMERA_NAMES[cam_id]})"
                    sheet_name = f"{base_name}_{chunk_idx+1}" if num_chunks > 1 else base_name
                    # Excel worksheet name limit is 31 characters
                    sheet_name = sheet_name[:31]
                    df_chunk.to_excel(writer, sheet_name=sheet_name, index=False)
                    formatted_sheets.append((sheet_name, len(df_chunk.columns)))

        # Tab 3: 3D Reconstructed World Coordinates
        if not df_3d.empty:
            total_3d_rows = len(df_3d)
            num_chunks_3d = math.ceil(total_3d_rows / max_excel_rows)
            for chunk_idx in range(num_chunks_3d):
                start_idx = chunk_idx * max_excel_rows
                end_idx = start_idx + max_excel_rows
                df_chunk_3d = df_3d.iloc[start_idx:end_idx]
                
                sheet_name = f"3D World_{chunk_idx+1}" if num_chunks_3d > 1 else "3D World Coords"
                df_chunk_3d.to_excel(writer, sheet_name=sheet_name, index=False)
                formatted_sheets.append((sheet_name, len(df_chunk_3d.columns)))

    # Apply OpenPyXL styles and freeze top row
    wb = load_workbook(path)
    for sheet_name, num_cols in formatted_sheets:
        if sheet_name in wb.sheetnames:
            ws = wb[sheet_name]
            _style_header(ws, 1, num_cols)
            ws.freeze_panes = "A2"
            _autowidth(ws)

    wb.save(path)


