VIDEO_EXTS = {".mp4", ".mov", ".avi", ".mkv", ".MP4"}

def discover_inputs(cam_inputs: Dict[int, str], mode: str) -> Dict[str, Dict[int, str]]:
    """
    Finds video files across all camera folders while preserving nested subfolders.
    This code does the action of matching video names across camera angles.
    This code is related to maintaining trial folder structures like 'Trial_01/recording.mp4'.
    This code will work only if options: All cameras contain matching subfolder and file names.
    """
    sessions: Dict[str, Dict[int, str]] = {}

    if mode == "Folders":
        for cam_idx, folder in cam_inputs.items():
            if not os.path.exists(folder):
                raise FileNotFoundError(f"Missing root folder for Camera {cam_idx}: {folder}")

            for root, _, files in os.walk(folder):
                rel_dir = os.path.relpath(root, folder)
                for f in sorted(files):
                    if os.path.splitext(f)[1].lower() in VIDEO_EXTS and not f.startswith("calib"):
                        full_path = os.path.join(root, f)
                        rel_file = os.path.normpath(os.path.join(rel_dir, f))
                        
                        if rel_file not in sessions:
                            sessions[rel_file] = {}
                        sessions[rel_file][cam_idx] = full_path
    else:
        for cam_idx, file_path in cam_inputs.items():
            if not os.path.isfile(file_path):
                raise FileNotFoundError(f"Selected file not found for Camera {cam_idx}: {file_path}")
            fname = os.path.basename(file_path)
            if fname not in sessions:
                sessions[fname] = {}
            sessions[fname][cam_idx] = file_path

    return sessions

def inspect_video_stream(video_path: str, cam_idx: int, session_name: str = "") -> dict:
    """
    Reads a video file to report its technical parameters (resolution, FPS, frames, file size).
    This code does the action of performing a technical pre-flight check on every video.
    This code is related to verifying video quality and stream health before tracking starts.
    This code will work only if options: The video file can be opened by OpenCV.
    """
    file_bytes = os.path.getsize(video_path)
    size_mb = round(file_bytes / (1024 * 1024), 2)

    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        raise RuntimeError(f"Video Detector could not open file: {video_path}")

    fps = cap.get(cv2.CAP_PROP_FPS) or 30.0
    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    cap.release()

    return {
        "session": session_name,
        "camera_id": cam_idx,
        "camera_view": CAMERA_NAMES[cam_idx],
        "video_filename": os.path.basename(video_path),
        "resolution": f"{width}x{height}",
        "width_px": width,
        "height_px": height,
        "fps": round(fps, 2),
        "total_frames": total_frames,
        "file_size_mb": size_mb,
        "video_path": video_path
    }

def run_external_calibration(calib_script_path: str, output_folder: str, cam_folders: Dict[int, str], log_fn):
    """
    Executes a user-provided Python script to calculate camera calibration matrices.
    This code does the action of running mathematical lens calibration on demand.
    This code is related to camera distortion removal and multi-camera space alignment.
    This code will work only if options: A valid .py calibration script is selected.
    """
    log_fn(f"[Calibration] Loading external script: {calib_script_path}")
    spec = importlib.util.spec_from_file_location("user_calib_module", calib_script_path)
    if spec is None or spec.loader is None:
        raise ImportError(f"Could not load script at {calib_script_path}")
    
    calib_mod = importlib.util.module_from_spec(spec)
    sys.modules["user_calib_module"] = calib_mod
    spec.loader.exec_module(calib_mod)

    if hasattr(calib_mod, "run_calibration"):
        log_fn("[Calibration] Executing run_calibration(output_folder, cam_folders)...")
        calib_mod.run_calibration(output_folder=output_folder, cam_folders=cam_folders)
    elif hasattr(calib_mod, "main"):
        log_fn("[Calibration] Executing main()...")
        calib_mod.main()
    else:
        log_fn("[Calibration] Script executed at root module level.")
    log_fn("[Calibration] Calibration process finished.")

def run_full_pipeline(cfg: dict, log_fn, progress_fn, finish_fn):
    """
    Executes the entire video analysis process from start to finish.
    This code does the action of tracking joints, writing labeled videos, triangulating 
    3D landmarks, and generating isolated skeleton and hand Excel sheets in mirrored subfolders.
    This code will work only if options:
      A: Camera video sources exist.
      B: The user provided a 4-sentence explanation on Window 2.
      C: Output write permissions are granted on your computer.
    """
    input_mode: str = cfg.get("input_mode", "Folders")
    active_indices: List[int] = cfg["active_cameras"]
    cam_inputs = {i: cfg["cam_inputs"][i] for i in active_indices}
    output_dir: str = cfg["output_folder"]
    need_calib: bool = cfg["need_calibration"]
    calib_script: str = cfg.get("calib_script", "")
    run_decision_tree: str = cfg.get("run_decision_tree", "No")
    justification_text: str = cfg.get("justification_text", "")

    base_out_videos = os.path.join(output_dir, "output_videos")
    base_out_excel  = os.path.join(output_dir, "output_excel")
    os.makedirs(base_out_videos, exist_ok=True)
    os.makedirs(base_out_excel, exist_ok=True)

    log_file_path = os.path.join(output_dir, "pipeline_execution_log.txt")

    def dual_log(msg: str):
        """Writes messages to both the visual window and the persistent text log."""
        timestamp = datetime.now().strftime("[%Y-%m-%d %H:%M:%S]")
        full_line = f"{timestamp} {msg}"
        log_fn(msg)
        try:
            with open(log_file_path, "a", encoding="utf-8") as f:
                f.write(full_line + "\n")
        except Exception:
            pass

    dual_log("=" * 80)
    dual_log("NEW MULTI-CAMERA MOTION CAPTURE PIPELINE SESSION STARTED")
    dual_log(f"Input Processing Mode: {input_mode}")
    dual_log(f"Active Camera Viewpoints ({len(active_indices)} total): " + ", ".join(f"Cam {i} ({CAMERA_NAMES[i]})" for i in active_indices))
    dual_log(f"Decision Tree Execution Requested (Yes/No Radio Selection): {run_decision_tree}")
    dual_log(f"Calibration Requested (Yes/No Radio Selection): {'Yes' if need_calib else 'No'}")
    dual_log(f"User Stated Reason for Running:\n{justification_text}")
    dual_log(f"Output Directory: {output_dir}")
    dual_log("=" * 80)

    try:
        # STEP 1: Run Camera Calibration if requested by user
        calib_npz_path = os.path.join(output_dir, "calibration_data.npz")
        if need_calib:
            dual_log("[Pipeline] Running camera calibration step...")
            if not os.path.isfile(calib_script):
                raise FileNotFoundError(f"Calibration script not found: {calib_script}")
            run_external_calibration(calib_script, output_dir, cam_inputs, dual_log)

        # STEP 2: Load Camera Calibration Matrices for 3D Math
        P_mats, K_mats, dist_mats = {}, {}, {}
        if os.path.exists(calib_npz_path):
            dual_log(f"[Pipeline] Loading calibration matrices from: {calib_npz_path}")
            calib_data = np.load(calib_npz_path, allow_pickle=True)
            raw_K = calib_data['K']
            raw_dist = calib_data['dist']
            raw_R = calib_data['R']
            raw_T = calib_data['T']
            
            for i in active_indices:
                if i < len(raw_K):
                    K_mats[i] = raw_K[i]
                    dist_mats[i] = raw_dist[i]
                    Rt = np.hstack((raw_R[i], raw_T[i]))
                    P_mats[i] = raw_K[i] @ Rt
            dual_log(f"[Pipeline] Derived projection matrices for {len(P_mats)} active camera(s).")
        else:
            P_mats = None
            dual_log("[Pipeline] Notice: calibration_data.npz not detected. 3D triangulation will be bypassed.")

        # STEP 3: Discover Synchronized Videos Across Camera Folders
        dual_log(f"[Pipeline] Discovering video sources using mode: {input_mode}...")
        session_dict = discover_inputs(cam_inputs, input_mode)
        
        valid_sessions = {}
        for rel_item, cam_map in session_dict.items():
            missing = [i for i in active_indices if i not in cam_map]
            if not missing:
                valid_sessions[rel_item] = cam_map
            else:
                missing_str = ", ".join(f"Cam {i} ({CAMERA_NAMES[i]})" for i in missing)
                dual_log(f"[Warning] Session '{rel_item}' is missing active camera streams ({missing_str}). Skipping.")

        if not valid_sessions:
            raise ValueError("No synchronized video sets matching across all selected cameras were found.")

        dual_log(f"[Pipeline] Total synchronized session(s) detected: {len(valid_sessions)}")
        session_keys = sorted(valid_sessions.keys())

        # STEP 4: Run Technical Pre-Flight Video Detector Audit
        dual_log("\n" + "─" * 70)
        dual_log("VIDEO DETECTOR: AUDITING ALL CAMERA STREAMS ACROSS ALL SESSIONS")
        dual_log("─" * 70)
        all_stream_metadata_records = []
        for s_idx, rel_key in enumerate(session_keys):
            subfolder_prefix = os.path.dirname(rel_key)
            sess_label = f"Session_{s_idx+1} ({rel_key})"
            dual_log(f"── {sess_label} [Subfolder: '{subfolder_prefix or 'Root'}'] ──")
            for i in active_indices:
                vpath = valid_sessions[rel_key][i]
                vinfo = inspect_video_stream(vpath, i, session_name=sess_label)
                vinfo["subfolder"] = subfolder_prefix
                all_stream_metadata_records.append(vinfo)
                dual_log(
                    f"  Cam {i} ({vinfo['camera_view']:<13}) | "
                    f"Res: {vinfo['resolution']:<10} | "
                    f"FPS: {vinfo['fps']:<6} | "
                    f"Frames: {vinfo['total_frames']:<6} | "
                    f"Size: {vinfo['file_size_mb']} MB | Path: {rel_key}"
                )
        dual_log("─" * 70 + "\n")

        # STEP 5: Initialize Pose and Hand Models
        dual_log("[Pipeline] Initializing MediaPipe Pose and Hand tracking models...")
        pose_estimators = {
            i: mp_pose.Pose(
                static_image_mode=False,
                min_detection_confidence=0.5,
                min_tracking_confidence=0.5
            ) for i in active_indices
        }
        hands_estimator = mp_hands.Hands(
            static_image_mode=True,
            max_num_hands=2,
            min_detection_confidence=0.35,
            min_tracking_confidence=0.3
        )
        crop_scale = 0.30

        # STEP 6: Process Every Session and Mirror Folder Trees
        first_cam = active_indices[0]
        n_sessions = len(session_keys)

        for sess_idx, rel_key in enumerate(session_keys):
            session_videos = valid_sessions[rel_key]
            
            # Recreate identical subfolder paths inside output folders
            rel_dir = os.path.dirname(rel_key)
            cur_out_videos_dir = os.path.join(base_out_videos, rel_dir)
            cur_out_excel_dir  = os.path.join(base_out_excel, rel_dir)
            os.makedirs(cur_out_videos_dir, exist_ok=True)
            os.makedirs(cur_out_excel_dir, exist_ok=True)

            base_session_name = os.path.splitext(os.path.basename(rel_key))[0]
            dual_log(f"\n[Session {sess_idx + 1}/{n_sessions}] Processing: {rel_key}")
            dual_log(f"  Target Video Output Folder: {cur_out_videos_dir}")
            dual_log(f"  Target Excel Output Folder: {cur_out_excel_dir}")

            caps = {}
            for i in active_indices:
                cap = cv2.VideoCapture(session_videos[i])
                if not cap.isOpened():
                    raise RuntimeError(f"Cannot open video stream for Camera {i}: {session_videos[i]}")
                caps[i] = cap

            cam_fps = {i: (caps[i].get(cv2.CAP_PROP_FPS) or 30.0) for i in active_indices}
            cam_dims = {}
            for i in active_indices:
                ret, peek = caps[i].read()
                if not ret:
                    raise RuntimeError(f"Cannot read frame 0 from Camera {i}")
                cam_dims[i] = peek.shape[:2]
                caps[i].set(cv2.CAP_PROP_POS_FRAMES, 0)

            total_frames = int(caps[first_cam].get(cv2.CAP_PROP_FRAME_COUNT)) or 1
            dual_log(f"  Frame count: ~{total_frames} frames across {len(active_indices)} camera views.")

            # Open video writers in the mirrored subfolder
            writers = {
                i: cv2.VideoWriter(
                    os.path.join(cur_out_videos_dir, f"{base_session_name}_cam{i}_labeled.mp4"),
                    cv2.VideoWriter_fourcc(*"mp4v"), cam_fps[i], (cam_dims[i][1], cam_dims[i][0])
                ) for i in active_indices
            }

            # Isolated coordinate collectors for MediaPipe Skeleton and Hand Markers
            cam_skel_rows: Dict[int, List[list]] = {i: [] for i in active_indices}
            cam_hand_rows: Dict[int, List[list]] = {i: [] for i in active_indices}
            rows_3d: List[dict] = []
            frame_idx = 0

            while True:
                frames = {}
                read_success = True
                for i in active_indices:
                    ret, f = caps[i].read()
                    if not ret:
                        read_success = False
                        break
                    frames[i] = f
                if not read_success:
                    break

                pose_results = {}
                for i in active_indices:
                    rgb = cv2.cvtColor(frames[i], cv2.COLOR_BGR2RGB)
                    pose_results[i] = pose_estimators[i].process(rgb)

                # Generate shared, synchronized time markers
                ref_fps = cam_fps[first_cam]
                elapsed_sec = frame_idx / ref_fps
                hours = int(elapsed_sec // 3600)
                minutes = int((elapsed_sec % 3600) // 60)
                seconds = elapsed_sec % 60
                timestamp_str = f"{hours:02d}:{minutes:02d}:{seconds:06.3f}"

                # Calculate 3D triangulation coordinates
                if P_mats is not None:
                    for lm_idx, lm_name in enumerate(pose_landmarks_names):
                        valid_2d = {}
                        for i in active_indices:
                            res = pose_results[i]
                            if res.pose_landmarks:
                                lm = res.pose_landmarks.landmark[lm_idx]
                                if getattr(lm, "visibility", 1.0) > 0.35:
                                    h_c, w_c = cam_dims[i]
                                    px_raw = np.array([[[lm.x * w_c, lm.y * h_c]]], dtype=np.float32)
                                    px_undist = cv2.undistortPoints(px_raw, K_mats[i], dist_mats[i], P=K_mats[i])
                                    valid_2d[i] = px_undist[0][0]

                        if len(valid_2d) >= 2:
                            X3D = triangulate_point_multiview(valid_2d, P_mats)
                            rows_3d.append({
                                "frame": frame_idx,
                                "timestamp": timestamp_str,
                                "landmark_id": lm_idx,
                                "landmark_name": lm_name,
                                "X_mm": round(X3D[0], 2),
                                "Y_mm": round(X3D[1], 2),
                                "Z_mm": round(X3D[2], 2),
                                "cams_used": len(valid_2d)
                            })

                # Extract and isolate MediaPipe skeleton landmarks and hand markers
                for i in active_indices:
                    annotated = frames[i].copy()
                    bh, bw = annotated.shape[:2]
                    pres = pose_results[i]

                    # Identical timestamp calculations across skeleton and hand markers
                    cam_elapsed = frame_idx / cam_fps[i]
                    cam_ts = f"{int(cam_elapsed//3600):02d}:{int((cam_elapsed%3600)//60):02d}:{cam_elapsed%60:06.3f}"

                    if pres.pose_landmarks:
                        # Draw full-body skeleton
                        draw_complete_pose(annotated, pres.pose_landmarks, bw, bh)

                        # Isolate body skeleton landmarks into their own row collection
                        for idx, lm in enumerate(pres.pose_landmarks.landmark):
                            cam_skel_rows[i].append([
                                frame_idx, cam_ts, i, "pose", "", pose_landmarks_names[idx], idx,
                                round(lm.x, 6), round(lm.y, 6), round(lm.z, 6),
                                int(lm.x * bw), int(lm.y * bh), round(getattr(lm, "visibility", 0.0), 4)
                            ])

                        # Wrist coordinates to guide hand search
                        lw = pres.pose_landmarks.landmark[mp_pose.PoseLandmark.LEFT_WRIST]
                        rw = pres.pose_landmarks.landmark[mp_pose.PoseLandmark.RIGHT_WRIST]
                        wrists = [("left", int(lw.x * bw), int(lw.y * bh), lw.visibility),
                                  ("right", int(rw.x * bw), int(rw.y * bh), rw.visibility)]
                        frame_rgb = cv2.cvtColor(annotated, cv2.COLOR_BGR2RGB)

                        # Isolate hand markers into their own row collection
                        for side, cx, cy, vis in wrists:
                            if vis is not None and vis < 0.05:
                                continue
                            x1, y1, x2, y2 = crop_square_around(cx, cy, crop_scale, bw, bh)
                            crop_rgb = frame_rgb[y1:y2, x1:x2]
                            if crop_rgb.size == 0:
                                continue

                            hands_res = hands_estimator.process(crop_rgb)
                            if not hands_res or not hands_res.multi_hand_landmarks:
                                continue

                            cw_crop, ch_crop = x2 - x1, y2 - y1
                            for hand_lms in hands_res.multi_hand_landmarks:
                                norm_lms = []
                                for lm in hand_lms.landmark:
                                    fx = (x1 + lm.x * cw_crop) / float(bw)
                                    fy = (y1 + lm.y * ch_crop) / float(bh)
                                    norm_lms.append(landmark_pb2.NormalizedLandmark(x=fx, y=fy, z=lm.z))
                                mp_drawing.draw_landmarks(annotated, landmark_pb2.NormalizedLandmarkList(landmark=norm_lms), mp_hands.HAND_CONNECTIONS)

                                for idx, lm in enumerate(hand_lms.landmark):
                                    x_px, y_px = x1 + int(lm.x * cw_crop), y1 + int(lm.y * ch_crop)
                                    name = hand_landmarks_names[idx] if idx < len(hand_landmarks_names) else f"hand_{idx}"
                                    cam_hand_rows[i].append([
                                        frame_idx, cam_ts, i, "hand_crop", side, name, idx,
                                        round(x_px / float(bw), 6), round(y_px / float(bh), 6), round(lm.z, 6),
                                        x_px, y_px, 1.0
                                    ])

                    cv2.putText(annotated, f"Cam {i} ({CAMERA_NAMES[i]}) | Frame {frame_idx} [{cam_ts}]", (10, 22),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.50, (0, 255, 0), 1, cv2.LINE_AA)
                    writers[i].write(annotated)

                frame_idx += 1
                if frame_idx % 20 == 0 or frame_idx == total_frames:
                    pct = int((frame_idx / total_frames) * 100)
                    progress_fn(pct)
                    dual_log(f"  Frame {frame_idx}/{total_frames} ({pct}%) processed | Time: {timestamp_str}")

            for c in caps.values():
                c.release()
            for w in writers.values():
                w.release()

            # STEP 7: Save Isolated Excel Spreadsheets Inside Mirrored Subfolder
            now_str = datetime.now().strftime("%Y%m%d_%H%M%S")
            dual_log(f"  Writing isolated Excel sheets to subfolder: '{cur_out_excel_dir}'...")

            cols = ["frame", "timestamp", "camera_id", "source", "side", "landmark_name", "landmark_id",
                    "x_norm", "y_norm", "z_relative", "x_px", "y_px", "visibility"]

            df_3d = pd.DataFrame(rows_3d)
            metadata_df = pd.DataFrame(all_stream_metadata_records)

            for i in active_indices:
                df_skel = pd.DataFrame(cam_skel_rows[i], columns=cols)
                if not df_skel.empty:
                    df_skel = df_skel.sort_values(["frame", "landmark_id"]).reset_index(drop=True)

                df_hnd = pd.DataFrame(cam_hand_rows[i], columns=cols)
                if not df_hnd.empty:
                    df_hnd = df_hnd.sort_values(["frame", "side", "landmark_id"]).reset_index(drop=True)

                safe_name = CAMERA_NAMES[i].replace("°", "").replace(" ", "_")
                filename = f"{safe_name}_{now_str}.xlsx"
                out_cam_excel = os.path.join(cur_out_excel_dir, filename)

                # Write separate identifiable sheets for MediaPipe Skeleton and Hand Markers
                write_isolated_camera_excel(
                    file_path=out_cam_excel,
                    cam_id=i,
                    cam_name=CAMERA_NAMES[i],
                    df_skeleton=df_skel,
                    df_hands=df_hnd,
                    metadata_df=metadata_df,
                    df_3d=df_3d if i == first_cam else None
                )
                dual_log(f"  Saved isolated Excel for Cam {i} ({CAMERA_NAMES[i]}): {out_cam_excel}")

        for pe in pose_estimators.values():
            pe.close()
        hands_estimator.close()

        if run_decision_tree == "Yes":
            dual_log("[Pipeline] Decision Tree Analysis setting was set to YES. (Executing module...)")
        else:
            dual_log("[Pipeline] Decision Tree Analysis was set to NO. (Bypassed as requested.)")

        dual_log("\n[Complete] All sessions successfully processed across subfolder hierarchies!")
        finish_fn(True, "Pipeline finished successfully.")

    except Exception as e:
        dual_log(f"\n[ERROR] Pipeline failed: {str(e)}")
        finish_fn(False, str(e))


