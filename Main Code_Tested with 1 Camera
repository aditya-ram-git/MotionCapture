    def get_selected_camera_indices(self) -> List[int]:
        """Returns integer indexes (0 through 5) of checked cameras."""
        return [i for i, var in enumerate(self.cam_checkbox_vars) if var.get()]

    def count_valid_sentences(self, text: str) -> int:
        """
        Counts complete sentences ending with '.', '!', or '?'.
        This code does the action of verifying that at least 4 full sentences are entered.
        This code is related to experiment documentation and mandatory audit tracking.
        This code will work only if options: Each detected sentence contains at least 3 words.
        """
        raw_sentences = re.split(r'[.!?]+', text)
        valid = [s.strip() for s in raw_sentences if len(s.strip().split()) >= 3]
        return len(valid)

