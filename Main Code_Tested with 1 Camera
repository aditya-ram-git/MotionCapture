            ttk.Button(nav, text=next_label, style="Nav.TButton", command=next_cmd).pack(side=tk.RIGHT, padx=5)
        if back_cmd:
            ttk.Button(nav, text="Back", style="Nav.TButton", command=back_cmd).pack(side=tk.RIGHT, padx=5)
        ttk.Button(nav, text="Restart", style="Nav.TButton", command=self.restart_app).pack(side=tk.LEFT, padx=5)

    def show_window(self, window_idx: int):
        self.current_window = window_idx
        for idx, frame in self.frames.items():
            frame.pack_forget()

        if window_idx == 2:
            self.refresh_camera_rows()
            self.toggle_calib_ui()

        self.frames[window_idx].pack(fill=tk.BOTH, expand=True)

    def toggle_calib_ui(self):
        if self.need_calib_var.get() == "Yes":
            self.calib_file_frame.pack(fill=tk.X, pady=(5, 0))
        else:
            self.calib_file_frame.pack_forget()

    def browse_camera_input(self, idx: int):
        mode = self.input_mode_var.get()
        if mode == "Folders":
            path = filedialog.askdirectory(title=f"Select Root/Subfolder for {CAMERA_NAMES[idx]} View")
            if path:
                self.cam_input_vars[idx].set(path)
        else:
            path = filedialog.askopenfilename(
                title=f"Select Video File for {CAMERA_NAMES[idx]} View",
                filetypes=[("Video Files", "*.mp4 *.mov *.avi *.mkv *.MP4"), ("All Files", "*.*")]
            )
            if path:
                self.cam_input_vars[idx].set(path)

    def browse_calib_file(self):
        path = filedialog.askopenfilename(
            title="Select Calibration Python Script",
            filetypes=[("Python Files", "*.py"), ("All Files", "*.*")]
        )
        if path:
            self.calib_script_var.set(path)

    def browse_output_folder(self):
        path = filedialog.askdirectory(title="Select Destination Output Folder")
        if path:
            self.output_dir_var.set(path)

    def validate_window_2(self):
        """
        Validates all folder paths and enforces the 4-sentence requirement.
        This code does the action of preventing the user from continuing until inputs are valid.
        This code will work only if options:
          A: All camera directories exist.
          B: Any requested calibration script exists.
          C: At least 4 full sentences are entered in the explanation box.
        """
        # Option A Validation: Check camera folders or files
        mode = self.input_mode_var.get()
        selected_indices = self.get_selected_camera_indices()
        for idx in selected_indices:
            p = self.cam_input_vars[idx].get().strip()
            if mode == "Folders":
                if not p or not os.path.isdir(p):
                    messagebox.showerror(
                        "Missing Folder", 
                        f"Please select a valid folder for:\nOption {idx+1}: {CAMERA_NAMES[idx]} Camera"
                    )
                    return
            else:
                if not p or not os.path.isfile(p):
                    messagebox.showerror(
                        "Missing File", 
                        f"Please select a valid video file for:\nOption {idx+1}: {CAMERA_NAMES[idx]} Camera"
                    )
                    return

        # Option B Validation: Check calibration script if Yes was selected
        if self.need_calib_var.get() == "Yes":
            calib_p = self.calib_script_var.get().strip()
            if not calib_p or not os.path.isfile(calib_p):
                messagebox.showerror("Missing Calibration File", "Please select a valid calibration Python file.")
                return

        # Option C Validation: Verify at least 4 full sentences
        text = self.justification_entry.get("1.0", tk.END).strip()
        sentence_count = self.count_valid_sentences(text)
        if sentence_count < 4:
            messagebox.showerror(
                "Execution Purpose Required",
                f"You must describe why you are running this code right now.\n\n"
                f"Requirement: At least 4 full sentences.\n"
                f"Currently detected: {sentence_count} complete sentence(s).\n\n"
                f"Please ensure each sentence ends with punctuation (. ! or ?) and expresses a complete thought."
            )
            return

        self.justification_text = text
        self.show_window(3)

    def start_pipeline_trigger(self):
        out_p = self.output_dir_var.get().strip()
        if not out_p:
            messagebox.showerror("Missing Output Folder", "Please select a destination folder for output files.")
            return

        self.show_window(4)
        self.status_label.config(text="Status: Pipeline running...")

        selected_indices = self.get_selected_camera_indices()
        cfg = {
            "input_mode": self.input_mode_var.get(),
            "active_cameras": selected_indices,
            "cam_inputs": {i: self.cam_input_vars[i].get().strip() for i in selected_indices},
            "need_calibration": (self.need_calib_var.get() == "Yes"),
            "calib_script": self.calib_script_var.get().strip(),
            "output_folder": out_p,
            "run_decision_tree": self.run_decision_tree_var.get(),
            "justification_text": self.justification_text,
        }

        t = threading.Thread(
            target=run_full_pipeline,
            args=(cfg, self.log_message, self.update_progress, self.on_pipeline_finish),
            daemon=True
        )
        t.start()

    def restart_app(self):
        if messagebox.askyesno("Restart", "Reset all inputs and return to Start?"):
            self.input_mode_var.set("Folders")
            for var in self.cam_checkbox_vars:
                var.set(True)
            for v in self.cam_input_vars:
                v.set("")
            self.need_calib_var.set("No")
            self.calib_script_var.set("")
            self.output_dir_var.set("")
            self.run_decision_tree_var.set("No")
            self.justification_entry.delete("1.0", tk.END)
            self.log_text.delete("1.0", tk.END)
            self.prog_bar["value"] = 0
            self.show_window(0)

    def cancel_app(self):
        if messagebox.askyesno("Exit", "Are you sure you want to exit?"):
            self.destroy()

    def log_message(self, msg: str):
        self.log_queue.put(("log", msg))

    def update_progress(self, percent: int):
        self.log_queue.put(("progress", percent))

    def on_pipeline_finish(self, success: bool, msg: str):
        self.log_queue.put(("finish", (success, msg)))

    def poll_log_queue(self):
        while not self.log_queue.empty():
            msg_type, data = self.log_queue.get_nowait()
            if msg_type == "log":
                self.log_text.insert(tk.END, data + "\n")
                self.log_text.see(tk.END)
            elif msg_type == "progress":
                self.prog_bar["value"] = data
            elif msg_type == "finish":
                success, text = data
                self.status_label.config(text=f"Status: {'Completed' if success else 'Failed'}")
                if success:
                    messagebox.showinfo("Success", text)
                else:
                    messagebox.showerror("Pipeline Failed", text)

        self.after(100, self.poll_log_queue)


