def _style_header(ws, row: int, n_cols: int):
    """
    Paints a header row with dark blue shading and thin grid borders.
    This code does the action of making the top row look neat and easy to read.
    """
    for col in range(1, n_cols + 1):
        c = ws.cell(row=row, column=col)
        c.fill = HDR_FILL
        c.font = HDR_FONT
        c.border = THIN
        c.alignment = CENTER

def _autowidth(ws, min_w=10, max_w=32):
    """
    Adjusts spreadsheet column widths automatically so text is never cut off.
    This code does the action of calculating character lengths to expand columns cleanly.
    """
    for col_cells in ws.columns:
        length = max((len(str(c.value)) if c.value is not None else 0) for c in col_cells)
        ws.column_dimensions[get_column_letter(col_cells[0].column)].width = max(min_w, min(length + 3, max_w))

def write_isolated_camera_excel(
    file_path: str,
    cam_id: int,
    cam_name: str,
    df_skeleton: pd.DataFrame,
    df_hands: pd.DataFrame,
    metadata_df: pd.DataFrame,
    df_3d: Optional[pd.DataFrame] = None,
    max_excel_rows: int = 1000000
):
    """
    Creates an Excel spreadsheet containing separate tabs for MediaPipe Skeleton and Hand Markers.
    This code does the action of replacing the combined coordinate sheet with clean, isolated sheets.
    This code will work only if options: 
      A: A valid destination save path is provided.
      B: Skeleton and hand DataFrames share synchronized, identical frame and timestamp values.
      C: Excel row thresholds (max_excel_rows) are not exceeded without generating sequential split sheets.
    """
    formatted_sheets = []

    with pd.ExcelWriter(file_path, engine="openpyxl") as writer:
        # Tab 1: Technical Camera & Video Metadata
        if not metadata_df.empty:
            metadata_df.to_excel(writer, sheet_name="Video Metadata", index=False)
            formatted_sheets.append(("Video Metadata", len(metadata_df.columns)))

        # Tab Group 2: Dedicated "MediaPipe_Skeleton" Tabs
        total_skel_rows = len(df_skeleton)
        if total_skel_rows == 0:
            sheet_title = "MediaPipe_Skeleton"[:31]
            df_skeleton.to_excel(writer, sheet_name=sheet_title, index=False)
            formatted_sheets.append((sheet_title, len(df_skeleton.columns)))
        else:
            skel_chunks = math.ceil(total_skel_rows / max_excel_rows)
            for idx in range(skel_chunks):
                start = idx * max_excel_rows
                end = start + max_excel_rows
                chunk = df_skeleton.iloc[start:end]
                sheet_title = f"MediaPipe_Skeleton_{idx+1}" if skel_chunks > 1 else "MediaPipe_Skeleton"
                sheet_title = sheet_title[:31]
                chunk.to_excel(writer, sheet_name=sheet_title, index=False)
                formatted_sheets.append((sheet_title, len(chunk.columns)))

        # Tab Group 3: Dedicated "Hand_Markers" Tabs
        total_hand_rows = len(df_hands)
        if total_hand_rows == 0:
            sheet_title = "Hand_Markers"[:31]
            df_hands.to_excel(writer, sheet_name=sheet_title, index=False)
            formatted_sheets.append((sheet_title, len(df_hands.columns)))
        else:
            hand_chunks = math.ceil(total_hand_rows / max_excel_rows)
            for idx in range(hand_chunks):
                start = idx * max_excel_rows
                end = start + max_excel_rows
                chunk = df_hands.iloc[start:end]
                sheet_title = f"Hand_Markers_{idx+1}" if hand_chunks > 1 else "Hand_Markers"
                sheet_title = sheet_title[:31]
                chunk.to_excel(writer, sheet_name=sheet_title, index=False)
                formatted_sheets.append((sheet_title, len(chunk.columns)))

        # Tab Group 4: 3D Triangulated World Coordinates (Only written on Primary Camera file)
        if df_3d is not None and not df_3d.empty:
            total_3d = len(df_3d)
            chunks_3d = math.ceil(total_3d / max_excel_rows)
            for idx in range(chunks_3d):
                start = idx * max_excel_rows
                end = start + max_excel_rows
                chunk = df_3d.iloc[start:end]
                sheet_title = f"3D_World_{idx+1}" if chunks_3d > 1 else "3D_World_Coords"
                sheet_title = sheet_title[:31]
                chunk.to_excel(writer, sheet_name=sheet_title, index=False)
                formatted_sheets.append((sheet_title, len(chunk.columns)))

    # Apply visual corporate styling across all newly created sheets
    wb = load_workbook(file_path)
    for sheet_title, num_cols in formatted_sheets:
        if sheet_title in wb.sheetnames:
            ws = wb[sheet_title]
            _style_header(ws, 1, num_cols)
            ws.freeze_panes = "A2"
            _autowidth(ws)
    wb.save(file_path)


