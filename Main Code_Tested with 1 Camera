def _lm_idx(x):
    """
    Helper function: Safely extracts an integer landmark index regardless of whether
    MediaPipe passes it as an Enum object or a raw integer.
    """
    return x.value if hasattr(x, "value") else int(x)

# Precomputed list of landmark index pairs that form the skeleton lines
all_pose_connections = [
    (_lm_idx(a), _lm_idx(b)) for a, b in mp_pose.POSE_CONNECTIONS
]

def triangulate_point_multiview(points_2d: Dict[int, tuple], P_matrices: Dict[int, np.ndarray]) -> np.ndarray:
    """
    Direct Linear Transform (DLT) Multi-View 3D Triangulation.
    Takes 2D points from any subset of active cameras that see the landmark and 
    solves A * X = 0 using Singular Value Decomposition (SVD).
    """
    A = []
    for cam_idx, (x, y) in points_2d.items():
        P = P_matrices[cam_idx]
        A.append(x * P[2, :] - P[0, :])
        A.append(y * P[2, :] - P[1, :])
    A = np.array(A)

    # Solve A * X = 0 using SVD; the solution is the last row of V-transpose (Vh[-1])
    _, _, Vh = np.linalg.svd(A)
    X = Vh[-1]

    # Convert from 4D homogeneous coordinates [X, Y, Z, W] to 3D Euclidean coordinates [X, Y, Z]
    return (X[:3] / X[3])

def draw_complete_pose(frame, landmarks, w, h, color=(0, 255, 0), thickness=2, circle_radius=3):
    """
    Draws green skeleton lines and red joint dots onto a video frame for visible landmarks.
    """
    for ai, bi in all_pose_connections:
        la, lb = landmarks.landmark[ai], landmarks.landmark[bi]
        if getattr(la, "visibility", 1) < 0.1 or getattr(lb, "visibility", 1) < 0.1:
            continue
        xa = int(np.clip(la.x * w, 0, w - 1))
        ya = int(np.clip(la.y * h, 0, h - 1))
        xb = int(np.clip(lb.x * w, 0, w - 1))
        yb = int(np.clip(lb.y * h, 0, h - 1))
        cv2.line(frame, (xa, ya), (xb, yb), color, thickness)
        
    for idx, lm in enumerate(landmarks.landmark):
        if getattr(lm, "visibility", 1) < 0.05:
            continue
        cx = int(np.clip(lm.x * w, 0, w - 1))
        cy = int(np.clip(lm.y * h, 0, h - 1))
        cv2.circle(frame, (cx, cy), circle_radius, (0, 0, 255), -1)

def crop_square_around(cx, cy, scale_frac, w, h):
    """
    Calculates a square bounding box centered around (cx, cy) for zoomed-in wrist crops.
    """
    half = int(min(w, h) * scale_frac / 2)
    return max(cx - half, 0), max(cy - half, 0), min(cx + half, w), min(cy + half, h)


