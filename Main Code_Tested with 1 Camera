def _lm_idx(x):
    """
    Safely retrieves the integer number of a landmark.
    This code does the action of preventing program crashes when landmark names are formatted differently.
    """
    return x.value if hasattr(x, "value") else int(x)

all_pose_connections = [
    (_lm_idx(a), _lm_idx(b)) for a, b in mp_pose.POSE_CONNECTIONS
]

def triangulate_point_multiview(points_2d: Dict[int, tuple], P_matrices: Dict[int, np.ndarray]) -> np.ndarray:
    """
    Calculates a single 3D point in millimeters using 2D points from multiple cameras.
    This code does the action of combining two or more flat video viewpoints into true 3D spatial depth.
    This code is related to Direct Linear Transformation (DLT) geometry.
    This code will work only if options: Calibration matrices (P_matrices) exist and at least two cameras see the point.
    """
    A = []
    for cam_idx, (x, y) in points_2d.items():
        P = P_matrices[cam_idx]
        A.append(x * P[2, :] - P[0, :])
        A.append(y * P[2, :] - P[1, :])
    A = np.array(A)

    _, _, Vh = np.linalg.svd(A)
    X = Vh[-1]
    return X[:3] / X[3]

def draw_complete_pose(frame, landmarks, w, h, color=(0, 255, 0), thickness=2, circle_radius=3):
    """
    Draws green stick-figure skeleton lines and red joint dots onto a video picture.
    This code does the action of rendering visual confirmation that a body was detected.
    This code is related to producing human-inspectable output inspection videos.
    This code will work only if options: A valid video frame and detected body landmarks are present.
    """
    for ai, bi in all_pose_connections:
        la, lb = landmarks.landmark[ai], landmarks.landmark[bi]
        if getattr(la, "visibility", 1) < 0.1 or getattr(lb, "visibility", 1) < 0.1:
            continue
        xa = int(np.clip(la.x * w, 0, w - 1))
        ya = int(np.clip(la.y * h, 0, h - 1))
        xb = int(np.clip(lb.x * w, 0, w - 1))
        yb = int(np.clip(lb.y * h, 0, h - 1))
        cv2.line(frame, (xa, ya), (xb, yb), color, thickness)
        
    for lm in landmarks.landmark:
        if getattr(lm, "visibility", 1) < 0.05:
            continue
        cx = int(np.clip(lm.x * w, 0, w - 1))
        cy = int(np.clip(lm.y * h, 0, h - 1))
        cv2.circle(frame, (cx, cy), circle_radius, (0, 0, 255), -1)

def crop_square_around(cx, cy, scale_frac, w, h):
    """
    Calculates a square box around a wrist point to focus directly on the hand.
    This code does the action of zooming into the hand region for detailed finger tracking.
    This code is related to optimizing hand recognition accuracy.
    This code will work only if options: Wrist coordinates cx and cy fall within video boundary dimensions w and h.
    """
    half = int(min(w, h) * scale_frac / 2)
    return max(cx - half, 0), max(cy - half, 0), min(cx + half, w), min(cy + half, h)


